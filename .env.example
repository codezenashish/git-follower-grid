# ==============================================================================
# GitHub Follower Grid - Environment Configuration
# ==============================================================================

# GitHub Personal Access Token (classic or fine-grained with read:user scope)
# HIGHLY RECOMMENDED: Without a token, GitHub limits unauthenticated requests to
# 60 requests/hour per IP (which is quickly exhausted on shared cloud hosts like Vercel).
# With a token, GitHub allows up to 5,000 requests/hour.
GITHUB_TOKEN=

# Optional: Custom public domain URL (e.g. https://git-follower-grid.vercel.app)
# Used by the web interface to generate copyable README markdown snippets pointing
# to your live public deployment even when testing locally.
NEXT_PUBLIC_SITE_URL=

# Port for Next.js development server (default: 3000)
PORT=3000
